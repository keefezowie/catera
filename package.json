{
  "name": "catera",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev-demo.mjs",
    "dev:web": "npm run dev -w @catera/web",
    "dev:native": "npm run start -w @catera/customer",
    "build": "node scripts/sync-assets.mjs && npm run build -w @catera/web",
    "typecheck": "npm run typecheck -w @catera/web && npm run typecheck -w @catera/customer && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:postgres": "node --import tsx tests/postgres-concurrency.mjs",
    "demo:baseline": "node --import tsx scripts/v1-demo-baseline.mts",
    "demo:verify:hosted": "node scripts/verify-demo-accounts.mjs",
    "demo:verify:restore": "node --import tsx scripts/verify-demo-baseline-restore.mjs",
    "native:export": "npm run export -w @catera/customer",
    "assets": "node scripts/sync-assets.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
