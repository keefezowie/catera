# Web: copy to apps/web/.env.local. Never commit credentials.
# npm run dev uses Supabase by default. Set true only for synthetic local storage.
CATERA_V1_DEMO=false
CATERA_PUBLIC_URL=https://YOUR-V1-HOST.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
CRON_SECRET=
EXPO_ACCESS_TOKEN=
# Approved server-only routing and payout recipients, keyed by caterer UUID.
CATERA_XENDIT_ROUTING_JSON={}
CATERA_PAYOUT_RECIPIENTS_JSON={}
# Optional stable local demo signing key; otherwise generated in memory.
CATERA_SESSION_SECRET=
# Operators/tests only. Never expose in browser/native public variables.
DATABASE_URL=
TEST_DATABASE_URL=

# DOKU evaluation: separate staging DB + sandbox credentials only.
# Default collection provider is stored in v1.payment_provider_config; use the setup script.
CATERA_DOKU_STAGING=false
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRIVATE_KEY=
DOKU_COLLECTION_PROFILE_ID=
DOKU_COLLECTION_ACCOUNT_NO=
DOKU_PAYMENT_METHODS=VIRTUAL_ACCOUNT_BRI,QRIS
DOKU_COLLECTION_ENABLED=false
DOKU_ROUTING_VERIFIED=false
DOKU_PAYOUTS_ENABLED=false
DOKU_PAYOUT_CONTRACT_VERIFIED=false
DOKU_PAYOUT_CALLBACK_VERIFIED=false
# Explicit provider fee reserve, in whole IDR; no guessed commercial fee.
DOKU_PAYOUT_FEE_RESERVE_IDR=
CATERA_CONTROLLED_COLLECTION=false
