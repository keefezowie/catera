{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-contents/types/**/*.ts",
    ".next-contents/dev/types/**/*.ts",
    ".next-dishes/types/**/*.ts",
    ".next-dishes/dev/types/**/*.ts",
    ".next-dishes-build/types/**/*.ts",
    ".next-dishes-build/dev/types/**/*.ts",
    ".next-meal-calendar/types/**/*.ts",
    ".next-meal-calendar/dev/types/**/*.ts",
    ".next-package-presentation/types/**/*.ts",
    ".next-package-presentation/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
