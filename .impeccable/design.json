      "css": ".ds-btn-secondary{font-family:Jakarta,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:12px 20px;border:1px solid #CDD4C4;border-radius:10px;background:transparent;color:var(--forest, #163D2E);font-size:13px;font-weight:650;line-height:1.6;text-align:center;cursor:pointer;transition:background .18s,box-shadow .2s var(--ease,cubic-bezier(.16,1,.3,1));}.ds-btn-secondary:hover{background:var(--soft, #F0F3E9);}.ds-btn-secondary:focus-visible{outline:3px solid var(--focus, #B65B13);outline-offset:4px;}.ds-btn-secondary:disabled{cursor:not-allowed;opacity:.5;pointer-events:none;}@media(prefers-reduced-motion:reduce){.ds-btn-primary,.ds-btn-secondary,.ds-btn-cream,.ds-package-card{transition:none!important;}}"
