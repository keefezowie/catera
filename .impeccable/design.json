    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "input",
      "description": "Existing labeled text field; the wrapper supplies its 12px type, with current muted placeholder and keyboard focus.",
      "html": "<label class=\"ds-field\"><span>Nama alamat</span><input class=\"ds-input\" type=\"text\" placeholder=\"Contoh: Rumah\" /></label>",
      "css": ".ds-field{font-family:Jakarta,sans-serif;display:flex;flex-direction:column;gap:8px;font-size:12px;line-height:1.6;}.ds-field>span{color:var(--forest, #163D2E);font-weight:650;}.ds-input{font-family:Jakarta,sans-serif;font-size:12px;line-height:1.6;color:var(--ink, #2E2E2E);background:var(--surface, #FFFEFA);border:1px solid #CFD3C6;border-radius:9px;min-height:44px;padding:11px 13px;max-width:100%;caret-color:var(--forest, #163D2E);}.ds-input::placeholder{color:var(--muted, #60675F);}.ds-input:focus-visible{outline:3px solid var(--focus, #B65B13);outline-offset:4px;}"
    },
    {
      "name": "Operations navigation",
      "kind": "nav",
      "refersTo": "nav-selected",
      "description": "Selected workspace destination and quiet sibling link; seller/admin menus remain distinct in the app.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Contoh navigasi operasional\"><a class=\"ds-nav-link ds-selected\" href=\"#hari-ini\" aria-current=\"page\"><svg aria-hidden=\"true\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1Z\"/></svg>Hari ini</a><a class=\"ds-nav-link\" href=\"#jadwal\"><svg aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>Jadwal</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:3px;max-width:244px;}.ds-nav-link{font-family:Jakarta,sans-serif;display:flex;align-items:center;gap:12px;padding:11px 13px;min-height:44px;font-size:12px;line-height:1.6;font-weight:550;color:#52604D;border-radius:8px;text-decoration:none;}.ds-nav-link.ds-selected{background:var(--forest, #163D2E);color:var(--cream, #FFF7E9);}.ds-nav-link:hover:not(.ds-selected){background:#EDF1E5;}.ds-nav-link svg{flex-shrink:0;}.ds-nav-link:focus-visible{outline:3px solid var(--focus, #B65B13);outline-offset:4px;}"
    },
    {
      "name": "Meal filter",
      "kind": "chip",
      "refersTo": "chip-selected",
      "description": "Selected and unselected meal controls with the implemented 44px web minimum height.",
      "html": "<div class=\"ds-chips\" role=\"group\" aria-label=\"Waktu makan\"><button type=\"button\" class=\"ds-chip ds-selected\" aria-pressed=\"true\">Semua</button><button type=\"button\" class=\"ds-chip\" aria-pressed=\"false\">Makan siang</button></div>",
      "css": ".ds-chips{display:flex;gap:10px;align-items:center;overflow:auto;padding-bottom:16px;}.ds-chip{font-family:Jakarta,sans-serif;display:flex;align-items:center;gap:9px;white-space:nowrap;min-height:44px;border:1px solid var(--line, #E2E3D8);border-radius:9px;background:transparent;padding:10px 18px;font-size:12px;line-height:1.6;color:var(--forest, #163D2E);font-weight:600;cursor:pointer;}.ds-chip.ds-selected{background:var(--forest, #163D2E);border-color:var(--forest, #163D2E);color:var(--cream, #FFF7E9);}.ds-chip:hover:not(.ds-selected){background:var(--soft, #F0F3E9);}.ds-chip:focus-visible{outline:3px solid var(--focus, #B65B13);outline-offset:4px;}.ds-chip:disabled{cursor:not-allowed;opacity:.5;pointer-events:none;}"
    },
    {
      "name": "Delivery status",
      "kind": "chip",
      "refersTo": "status-scheduled",
      "description": "Read-only status label; its dot supports the text instead of replacing it.",
      "html": "<span class=\"ds-status\"><span aria-hidden=\"true\"></span>Terjadwal</span>",
      "css": ".ds-status{font-family:Jakarta,sans-serif;display:inline-flex;align-items:center;gap:5px;padding:4px 8px;background:#EDF1E6;border-radius:5px;font-size:10px;line-height:1.6;color:#4F6445;white-space:nowrap;width:max-content;}.ds-status>span{width:4px;height:4px;background:currentColor;border-radius:50%;}"
    },
    {
      "name": "Package card body",
      "kind": "card",
      "refersTo": "package-card",
      "description": "Existing card boundary and body hierarchy. The panel omits the photograph; runtime cards use the provenance-tracked food images.",
      "html": "<article class=\"ds-package-card\"><div class=\"ds-package-body\"><div class=\"ds-caterer\">Demo sintetis</div><h3 class=\"ds-package-title\"><a class=\"ds-package-link\" href=\"#paket\">Paket makan siang</a></h3><p class=\"ds-package-meta\">Pengantaran termasuk · Paket fleksibel</p></div></article>",
      "css": ".ds-package-card{font-family:Jakarta,sans-serif;border:1px solid var(--line, #E2E3D8);border-radius:var(--radius,16px);overflow:hidden;background:var(--surface, #FFFEFA);color:var(--ink, #2E2E2E);min-width:0;transition:box-shadow .3s var(--ease,cubic-bezier(.16,1,.3,1));}.ds-package-card:hover{box-shadow:0 12px 28px #163d2e10;}.ds-package-body{padding:20px;}.ds-caterer{font-size:11px;line-height:1.6;color:var(--muted, #60675F);margin-bottom:8px;}.ds-package-title{margin:0 0 7px;font-size:19px;font-weight:750;line-height:1.22;letter-spacing:-.02em;color:var(--forest, #163D2E);}.ds-package-link{color:inherit;text-decoration:none;}.ds-package-meta{font-size:11px;line-height:1.6;margin:0;color:var(--muted, #60675F);}.ds-package-link:focus-visible{outline:3px solid var(--focus, #B65B13);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-btn-primary,.ds-btn-secondary,.ds-btn-cream,.ds-package-card{transition:none!important;}}"
