# Explicit local synthetic mode. Never enable on a public production deployment.
CATERA_DEMO_MODE=true
CATERA_SESSION_SECRET=replace-with-at-least-32-random-characters
# Hosted mode: set CATERA_DEMO_MODE=false and configure these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only auth provisioning for invited accounts, plus the provisioning CLI.
SUPABASE_SECRET_KEY=
# Required only by operational CLI tools and real Postgres integration tests.
DATABASE_URL=
