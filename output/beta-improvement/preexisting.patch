+  outline-offset: -4px;
+}
+.ops-list-toolbar,
+.ops-list-filter {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 12px;
+  margin-bottom: 16px;
+}
+.ops-list-toolbar:empty {
+  display: none;
+}
+.ops-list-toolbar .select-trigger,
+.ops-list-filter .select-trigger {
+  width: auto;
+  min-width: 220px;
+  max-width: 100%;
+}
+.ops-list-toolbar .ops-select-all {
+  margin: 0;
+}
+.ops-group-summary {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  white-space: normal;
+}
+.ops-group-summary > div {
+  min-width: 0;
+}
+.ops-group-summary strong {
+  font-size: 14px;
+  color: var(--forest);
+}
+.ops-group-summary small {
+  max-width: 75ch;
+  line-height: 1.6;
+}
+.ops-group-summary > span {
+  flex-shrink: 0;
+  font-size: 12px;
+  font-weight: 500;
+  color: var(--muted);
+}
+.ops-orders-panel .ops-order-table td[data-cell="actions"] {
+  min-width: 164px;
+}
+.ops-orders-panel .ops-order-table .order-next {
+  margin-top: 8px;
+}
+@media (max-width: 800px) {
+  .ops-group-summary {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 6px;
+  }
+  .ops-order-table .ops-group-heading {
+    display: block;
+  }
+  .ops-orders-panel .ops-order-table .ops-group-heading th:last-child {
+    display: block;
+    width: 100%;
+    white-space: normal;
+  }
+  .ops-orders-panel .ops-order-table tbody .ops-group-heading {
+    display: block;
+    padding: 0;
+    border: 0;
+    border-radius: 8px;
+    overflow: hidden;
+    background: var(--soft);
+  }
+  .ops-orders-panel .ops-order-table td[data-cell="actions"] {
+    width: auto;
+    min-width: 0;
+  }
+}
+@media (max-width: 560px) {
+  .ops-list-toolbar .select-trigger,
+  .ops-list-filter .select-trigger {
+    width: 100%;
+    min-width: 0;
+  }
+}
 .ops-orders-panel .section-heading h2 {
   margin: 0;
 }
